{#
/**
 * Translate plugin for Craft CMS 5.x
 *
 * Panel shown in the sidebar of an element's edit screen. This is how an
 * author discovers that the plugin can translate what they're looking at, so
 * it explains itself even when it can't do anything yet.
 *
 * Uses Craft's own `.meta > .field` markup so the rows line up with Slug,
 * Author and Post Date above rather than inventing a second layout.
 *
 * @link      https://enupal.com
 * @copyright Copyright (c) 2018 Enupal
 */
#}
{% import "_includes/forms" as forms %}

{% if currentUser.can('enupal-translate:translateContent') %}

    {% set ready = craft.enupaltranslate.isContentTranslationReady() %}
    {% set providerName = craft.enupaltranslate.getContentProviderName() %}
    {% set providers = ready ? craft.enupaltranslate.getEnabledProviders() : {} %}
    {% set defaultProvider = craft.enupaltranslate.getContentProviderHandle() %}
    {% set targets = ready ? craft.enupaltranslate.getTranslationTargets(element) : [] %}

    {#
        Craft auto-creates a provisional draft on every edit screen, so only
        flag a draft the author deliberately made. Translation always reads the
        canonical entry, which is what the controller works from.
    #}
    {% set isRealDraft = element.getIsDraft() and not element.isProvisionalDraft %}
    {% set showDraftNote = isRealDraft or element.getIsRevision() %}

    <fieldset>
        <legend class="h6">{{ "Enupal Translate"|t('enupal-translate') }}</legend>

        {% if not ready %}
            <div class="meta">
                <div class="field">
                    <div class="input">
                        <p class="light" style="margin: 0;">
                            {{ "Machine-translate this entry into your other sites."|t('enupal-translate') }}
                            {% if currentUser.admin %}
                                <a class="go" href="{{ url('enupal-translate/settings/providers') }}">
                                    {{ "Enable a provider"|t('enupal-translate') }}
                                </a>
                            {% endif %}
                        </p>
                    </div>
                </div>
            </div>

        {% elseif targets is empty %}
            <div class="meta">
                <div class="field">
                    <div class="input">
                        <p class="light" style="margin: 0;">
                            {{ "No other sites available to translate into."|t('enupal-translate') }}
                        </p>
                    </div>
                </div>
            </div>

        {% else %}

            {# Build the target options once, marking sites that already have a version. #}
            {% set targetOptions = [] %}
            {% for target in targets %}
                {% set label = target.site.name ~ ' (' ~ target.site.language ~ ')' %}
                {% set targetOptions = targetOptions|merge([{
                    label: target.exists ? label ~ ' — ' ~ 'exists'|t('enupal-translate') : label,
                    value: target.site.id
                }]) %}
            {% endfor %}
            {% if targets|length > 1 %}
                {% set targetOptions = targetOptions|merge([{
                    label: "All sites"|t('enupal-translate') ~ ' (' ~ targets|length ~ ')',
                    value: '*'
                }]) %}
            {% endif %}

            <form method="post" accept-charset="UTF-8">
                {{ csrfInput() }}
                {{ actionInput('enupal-translate/content/translate') }}
                {{ hiddenInput('elementId', element.canonicalId) }}
                {{ hiddenInput('elementType', className(element)) }}
                {{ hiddenInput('sourceSiteId', element.siteId) }}
                {{ redirectInput(element.cpEditUrl) }}

                <div class="meta">
                    <div class="field">
                        <div class="heading">
                            <label>{{ "From"|t('enupal-translate') }}</label>
                        </div>
                        <div class="input">
                            <span>{{ element.site.name }} ({{ element.site.language }})</span>
                            {% if showDraftNote %}
                                <span class="info">
                                    {{ "This is a draft. Translating uses the saved version of this entry, not the changes shown here."|t('enupal-translate') }}
                                </span>
                            {% endif %}
                        </div>
                    </div>

                    {% if providers|length > 1 %}
                        {{ forms.selectField({
                            label: "With"|t('enupal-translate'),
                            name: 'providerHandle',
                            options: providers,
                            value: defaultProvider
                        }) }}
                    {% else %}
                        {{ hiddenInput('providerHandle', defaultProvider) }}
                    {% endif %}

                    {{ forms.selectField({
                        label: "To"|t('enupal-translate'),
                        name: 'targetSiteId',
                        options: targetOptions,
                        value: targetOptions|first.value
                    }) }}

                    <div class="field">
                        <div class="input enupal-translate-actions">
                            <button type="submit" class="btn">
                                {{ "Translate"|t('enupal-translate') }}
                            </button>
                            <span class="light enupal-translate-meta">
                                {% if providers|length > 1 %}
                                    <a href="{{ url('enupal-translate/settings/content') }}">{{ "Settings"|t('enupal-translate') }}</a>
                                {% else %}
                                    {{ providerName }}
                                {% endif %}
                                &middot;
                                <a href="{{ url('enupal-translate/dashboard') }}">{{ "Usage"|t('enupal-translate') }}</a>
                            </span>
                        </div>
                    </div>
                </div>
            </form>

        {% endif %}

    </fieldset>

    {% css %}
        .enupal-translate-actions {
            flex: 1 1 auto;
            justify-content: space-between;
            gap: 8px;
        }
        .enupal-translate-meta {
            font-size: 12px;
            white-space: nowrap;
        }
    {% endcss %}

{% endif %}
